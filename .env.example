DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-only-key-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_MAX_UPLOAD_SIZE=104857600
DJANGO_MEDIA_STORAGE_BACKEND=filesystem
DJANGO_ADMIN_URL=admin
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1
DJANGO_SERVER_PORT=8000
DJANGO_SERVER_THREADS=8
DJANGO_SERVER_TIMEOUT=120

# PostgreSQL opcional para varios usuarios simultáneos.
# Déjalo comentado para continuar usando SQLite local.
# DJANGO_DB_ENGINE=postgresql
# POSTGRES_DB=lesiones
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=pon-aqui-la-clave
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_CONN_MAX_AGE=60

# Redis compartido para varios usuarios o instancias.
# DJANGO_CACHE_BACKEND=redis
# REDIS_URL=redis://127.0.0.1:6379/1

# El QR detecta automáticamente la IP Wi-Fi en desarrollo. Solo fija una URL
# si el equipo tiene varias redes o necesitas una dirección reservada:
# PROJECT_PUBLIC_URL=http://192.168.1.25:8000
#
# Para agregar la IP de tu red local a los hosts permitidos:
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.25

# En producción usa DEBUG=False, una clave aleatoria y HTTPS.
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_MAX_UPLOAD_SIZE=10485760
# DJANGO_ADMIN_URL=admin
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-dominio.com
