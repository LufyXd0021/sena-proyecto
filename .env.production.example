# Copia este archivo como .env en el servidor de producción.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=genera-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=observatorio.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://observatorio.example.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_X_FRAME_OPTIONS=DENY
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_ADMIN_URL=admin-seguro
DJANGO_MAX_UPLOAD_SIZE=104857600
DJANGO_MEDIA_STORAGE_BACKEND=filesystem

# Base de datos y caché compartidas.
DJANGO_DB_ENGINE=postgresql
POSTGRES_DB=lesiones
POSTGRES_USER=lesiones_app
POSTGRES_PASSWORD=pon-la-clave-de-postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
DJANGO_CACHE_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/1

# La URL pública debe ser HTTPS en producción.
PROJECT_PUBLIC_URL=https://observatorio.example.com
